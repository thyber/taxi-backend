# Plantilla de variables de entorno del backend (taxi-backend).
# NO incluir valores reales. En Render, define estas variables en el panel
# Environment (no subir .env; ya está ignorado por .gitignore).

# Render inyecta PORT automáticamente; no lo fijes en producción.
PORT=3000
NODE_ENV=development

# --- Variables existentes del servidor actual ---
# Cadena de conexión de MongoDB (Mongoose).
MONGODB_URI=your_mongodb_connection_string
# Secreto con el que se firman/verifican los JWT de login de la app.
JWT_SECRET=your_jwt_secret

# --- Proxy de Google Maps (FASE 7F.8A / 7F.8A.1) ---
# GOOGLE_MAPS_SERVER_KEY: clave de servidor de Google Maps (Web Service APIs:
#   Directions, Geocoding, Places). Se usa SOLO en el backend; nunca debe
#   exponerse al cliente ni versionarse. Sin este valor el proxy responde 503.
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key

# MAPS_PROXY_SERVICE_TOKEN: secreto compartido servidor-a-servidor para que el
#   chatbot consuma /api/maps mediante la cabecera x-internal-service-token.
#   Debe coincidir con el valor del chatbot. Mínimo 16 caracteres. Sin este
#   valor el acceso del chatbot queda deshabilitado (falla cerrado).
MAPS_PROXY_SERVICE_TOKEN=your_maps_proxy_service_token

# Credencial de Firebase Admin como JSON en UNA sola línea, para verificar los
#   Firebase ID tokens de las apps. ÚNICA fuente admitida: no se lee ningún
#   archivo de credenciales del repositorio. Sin este valor, las peticiones con
#   Bearer fallan con 401 (el resto del servidor sigue funcionando).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Límites de solicitudes del proxy de mapas (opcionales) ---
# Valores por defecto provisionales; variables inválidas caen al valor seguro.
# MAPS_RATE_LIMIT_WINDOW_MS=60000
# MAPS_RATE_LIMIT_DIRECTIONS=30
# MAPS_RATE_LIMIT_GEOCODE=30
# MAPS_RATE_LIMIT_PLACES_AUTOCOMPLETE=60
# MAPS_RATE_LIMIT_PLACES_DETAILS=60
# MAPS_RATE_LIMIT_SERVICE=180
# MAPS_RATE_LIMIT_GLOBAL=900
